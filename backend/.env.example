# RSG Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Database connection URL (MySQL 8)
DATABASE_URL="mysql://username:password@localhost:3306/rsg_db"

# JWT configuration
JWT_ACCESS_SECRET="your-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Nodemailer / SMTP (Optional for local dev, logs to console if omitted)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Region Security Guarding <no-reply@regionsecurityguarding.co.uk>"
FRONTEND_URL="http://localhost:5173"

